<Window x:Class="CrankoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:CrankoHub"
        x:Name="janela"
        Title="CrankoHub"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icone.ico"
        Background="#F5F5F7">

    <!-- Tira a barra de título do Windows; a nossa (estilo Mac) fica na primeira linha do Grid -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Cinza das bolinhas com a janela inativa (trocado junto com o tema) -->
        <SolidColorBrush x:Key="BolinhaInativa" Color="#CFCFCF" />

        <!-- Bolinha do semáforo: Tag = cor; o símbolo aparece com o mouse sobre o grupo -->
        <Style x:Key="Bolinha" TargetType="Button">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circulo" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                     Stroke="#33000000" StrokeThickness="0.5" />
                            <Path x:Name="simbolo" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="#99000000" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="6" Height="6" Stretch="Uniform" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=semaforo}" Value="True">
                                <Setter TargetName="simbolo" Property="Opacity" Value="1" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsActive, ElementName=janela}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, ElementName=semaforo}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="circulo" Property="Fill" Value="{DynamicResource BolinhaInativa}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circulo" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="raiz">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="barraTitulo" Background="#FFFFFF" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel x:Name="semaforo" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="12,0,0,0" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Bolinha}" Tag="#FF5F57" ToolTip="Fechar" Click="AoFechar"
                            Content="M0,0 L6,6 M6,0 L0,6" />
                    <Button Style="{StaticResource Bolinha}" Tag="#FEBC2E" ToolTip="Minimizar" Click="AoMinimizar"
                            Content="M0,3 L6,3" />
                    <Button Style="{StaticResource Bolinha}" Tag="#28C840" ToolTip="Maximizar" Click="AoMaximizar"
                            Content="M3,0 L3,6 M0,3 L6,3" />
                </StackPanel>
                <TextBlock x:Name="tituloJanela" Text="CrankoHub" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="SemiBold" Foreground="#48484A" />
            </Grid>
        </Border>

        <blazor:BlazorWebView Grid.Row="1" x:Name="blazorWebView"
                              HostPage="wwwroot\index.html"
                              Services="{DynamicResource services}"
                              BlazorWebViewInitializing="AoInicializarWebView">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>

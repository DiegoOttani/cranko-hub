@page "/"
@inject ArmazenamentoService Store

@{
    var d = Store.Dados;
    var rs = DietaCalculos.Ordenados(d.Dieta.Registros);
    var last = rs.LastOrDefault();
    var veic = CarroCalculos.VeiculoAtivo(d.Carro);
    var abs = CarroCalculos.DoVeiculo(d.Carro, veic.Id);
    var st = CarroCalculos.Estatisticas(abs);
    var gastoMes = CarroCalculos.GastoNoMes(abs, Hoje);

    // Peso de ~30 dias atrás (registro mais próximo)
    double? var30 = null;
    if (last is not null && rs.Count > 1)
    {
        var alvo = last.Data.DayNumber - 30;
        var referencia = rs.MinBy(r => Math.Abs(r.Data.DayNumber - alvo))!;
        if (referencia != last) var30 = last.Peso - referencia.Peso;
    }
    var meta = d.Dieta.Perfil.Meta;
    var perdendo = meta is null || rs.Count == 0 || meta < rs[0].Peso;

    var agora = DateTime.Now;
    var saudacao = agora.Hour < 12 ? "Bom dia" : agora.Hour < 18 ? "Boa tarde" : "Boa noite";

    var atividades = rs.TakeLast(6)
        .Select(r => (r.Data, Icone: Icones.Balanca, Texto: $"{Num(r.Peso)} kg registrados", Sub: string.IsNullOrEmpty(r.Obs) ? "Dieta" : r.Obs))
        .Concat(abs.TakeLast(6).Select(a => (a.Data, Icone: Icones.Bomba,
            Texto: $"{Num(a.Litros, 1)} L de {Combustivel.NomeDe(a.Combustivel)}{(a.Valor > 0 ? " · " + Money(a.Valor) : "")}",
            Sub: $"{veic.Nome} · {Num(a.Kml, 2)} km/l")))
        .OrderByDescending(x => x.Data)
        .Take(6)
        .ToList();

    // Mini-gráficos: últimos 90 dias
    var corte = Hoje.AddDays(-90);
}

<section class="hero">
    <p class="eyebrow">@DataPorExtenso(agora)</p>
    <h1>@(saudacao)!</h1>
    <p>Seu painel pessoal de parâmetros. Escolha uma área para registrar e acompanhar sua evolução.</p>
</section>

<div class="grid-2">
    <a class="card link-card" href="dieta">
        <div class="link-head">
            <span class="link-icon">@Icones.Coracao</span>
            <div><h2>Dieta</h2><p>Peso, medidas, IMC e meta</p></div>
            <span class="go">@Icones.Seta</span>
        </div>
        <div class="mini-stats">
            <div><span>Peso atual</span><b>@(last is not null ? Num(last.Peso) + " kg" : Vazio)</b></div>
            <div><span>Últimos 30 dias</span><b>@if (var30 is not null) { <Delta Valor="var30" Unidade=" kg" BomQuandoCai="perdendo" /> } else { @Vazio }</b></div>
            <div><span>Meta</span><b>@(meta is not null ? Num(meta) + " kg" : Vazio)</b></div>
        </div>
        <GraficoLinha Altura="150" Formato="FormatoNumero.Kg" MsgVazia="Sem pesos nos últimos 90 dias."
                      Series="@([new SerieLinha("Peso", "var(--series-1)", rs.Where(r => r.Data > corte).Select(r => new PontoLinha(r.Data, r.Peso)).ToList(), Markers: false, Area: true)])" />
    </a>
    <a class="card link-card" href="carro">
        <div class="link-head">
            <span class="link-icon">@Icones.Carro</span>
            <div><h2>Carro</h2><p>@veic.Nome · consumo e custos</p></div>
            <span class="go">@Icones.Seta</span>
        </div>
        <div class="mini-stats">
            <div><span>Consumo médio</span><b>@(st.Media is not null ? Num(st.Media) + " km/l" : Vazio)</b></div>
            <div><span>Custo por km</span><b>@Money(st.CustoKm)</b></div>
            <div><span>Gasto no mês</span><b>@Money(gastoMes)</b></div>
        </div>
        <GraficoLinha Altura="150" FormatoY="new FormatoNumero(1)" Formato="@(new FormatoNumero(2, " km/l"))" MsgVazia="Sem abastecimentos nos últimos 90 dias."
                      Series="@([new SerieLinha("Consumo", "var(--series-1)", abs.Where(a => a.Data > corte).Select(a => new PontoLinha(a.Data, a.Kml)).ToList(), Markers: false, Area: true)])" />
    </a>
</div>

<section class="card">
    <div class="card-head"><div><h2>Atividade recente</h2><p>Seus últimos registros em todas as áreas.</p></div></div>
    @if (atividades.Count > 0)
    {
        <ul class="activity">
            @foreach (var a in atividades)
            {
                <li>
                    <span class="a-icon">@a.Icone</span>
                    <div class="a-text">@a.Texto<small>@a.Sub</small></div>
                    <time>@DataBR(a.Data)</time>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="chart-empty"><span>Nada registrado ainda. Comece pela <a href="dieta">Dieta</a> ou pelo <a href="carro">Carro</a> — ou carregue dados de exemplo em <a href="dados">Dados &amp; backup</a>.</span></div>
    }
</section>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Versão Linux (Linux Mint / Cinnamon) do CrankoHub.
    Usa as MESMAS telas, modelos e serviços do projeto Windows (arquivos da pasta acima, por link);
    só a janela (Photino em vez de WPF) e as partes exclusivas do Windows são trocadas (pasta Plataforma).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CrankoHub</RootNamespace>
    <AssemblyName>CrankoHub</AssemblyName>

    <AssemblyTitle>CrankoHub</AssemblyTitle>
    <Product>CrankoHub</Product>
    <Version>1.0.0</Version>
    <Authors>Diego Ottani</Authors>
    <Description>Painel pessoal de parâmetros: dieta, carro e mais.</Description>
  </PropertyGroup>

  <!-- Publicação: pasta autossuficiente para Linux x64 (não precisa instalar o .NET no Mint) -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
  </ItemGroup>

  <!-- Código compartilhado com a versão Windows -->
  <ItemGroup>
    <!-- O Link repete o caminho original: é dele que o Razor tira o namespace (CrankoHub.Pages...) -->
    <Compile Include="..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Components\**\*.cs" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\Services\BandejaService.cs;..\Services\DialogoService.cs;..\Services\InicializacaoWindows.cs;..\Services\AtualizacaoService.cs" />

    <Content Include="..\Main.razor;..\_Imports.razor" Link="%(Filename)%(Extension)" CopyToOutputDirectory="Never" />
    <Content Include="..\Pages\**\*.razor" Link="Pages\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" />
    <Content Include="..\Components\**\*.razor" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" />
    <Content Include="..\Layout\**\*.razor" Link="Layout\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" />

    <Content Include="..\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="icone.png;crankohub.desktop;instalar.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
